SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bakehub
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Kolkata

ACCESS_SECRET=your-access-secret
REFRESH_SECRET=your-refresh-secret
ACCESS_TTL_MINUTE=15
REFRESH_TTL_HOUR=168
MAX_SESSION=720

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=bakehub <your-email@example.com>

OTP_LENGTH=5
OTP_EXPIRY_MINUTES=5

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

REDIS_ADDR=127.0.0.1:6379
